# local: use your real Supabase project URL
# production: https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# local: use your real Supabase publishable key
# production: your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# local: leave empty when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is set
# production: leave empty when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is set
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# local: http://127.0.0.1:4000
# production: https://your-core-service.onrender.com
QOTEON_CORE_API_URL=http://127.0.0.1:4000

# local: leave empty when QOTEON_CORE_API_URL is set
# production: expose only if browser-side Core URL access is required
NEXT_PUBLIC_QOTEON_CORE_API_URL=
